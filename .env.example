# Copy to .env and fill in real values. Never commit .env.

# Station
STATION_ID=deusto-ria-01
# Start values. After the first start they can be changed on the web page
# (stored in InfluxDB, measurement "settings").
# 5 min in the real station; use e.g. 10 for demos
PRESS_COOLDOWN_SECONDS=300
DAILY_PRESS_CAP=50
PRESSES_PER_PLANT=10
# servo locks the latch again after this time
LATCH_RELOCK_SECONDS=60
# back end rejects press or reading with timestamp more than this
# many seconds ahead of Pi clock (past timestamps always allowed).
MAX_FUTURE_SKEW_SECONDS=300

# Sensor read intervals in seconds (one per sensor): set after Sprint 1 tests
READ_INTERVAL_TEMP_HUMIDITY_SECONDS=
READ_INTERVAL_LIGHT_SECONDS=
READ_INTERVAL_PRESSURE_SECONDS=
READ_INTERVAL_SOIL_MOISTURE_SECONDS=
# SGP30: how often the latest value is sent (the script reads it every 1 s)
READ_INTERVAL_SGP30_SECONDS=
READ_INTERVAL_PIR_COUNT_SECONDS=

# API (FastAPI, also serves the web page)
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Web page login — one shared login for operators and partners
# Store only the password hash, never the plain password.
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=

# Database — InfluxDB 2 (Docker, deploy/compose.yaml)
DB_URL=http://localhost:8086
DB_ORG=pollinator-station
DB_BUCKET=pollinator
# Admin token: generate with `openssl rand -hex 32`. InfluxDB takes it on first start.
DB_TOKEN=
# InfluxDB admin login, created on first start. Password: `openssl rand -hex 32`.
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=

# MQTT broker — Mosquitto (Docker, bound to 127.0.0.1)
# Runs locally: the campus network blocks some outbound ports.
BROKER_HOST=localhost
BROKER_PORT=1883

# External data
EUSKALMET_API_KEY=

# Alerts — channel still open, see #42
ALERT_TOKEN=
ALERT_TARGET=
