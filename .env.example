# Copy to .env and fill in real values. Never commit .env.

# Station
STATION_ID=deusto-ria-01
PRESS_COOLDOWN_SECONDS=300      # 5 min in the real station; use e.g. 10 for demos
DAILY_PRESS_CAP=50
PRESSES_PER_PLANT=10

# API
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Database — depends on tool choice, see #58
DB_URL=
DB_TOKEN=
DB_NAME=

# Message broker (second protocol) — depends on tool choice, see #58
# Run it locally: the campus network blocks some outbound ports.
BROKER_HOST=localhost
BROKER_PORT=

# External data
EUSKALMET_API_KEY=

# Alerts — depends on tool choice, see #58
ALERT_TOKEN=
ALERT_TARGET=
