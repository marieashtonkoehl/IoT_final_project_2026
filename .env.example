# Copy to .env and fill in real values. Never commit .env.

# Station
STATION_ID=deusto-ria-01
# Start values. After the first start they can be changed on the web page
# (stored in InfluxDB, measurement "settings").
PRESS_COOLDOWN_SECONDS=300      # 5 min in the real station; use e.g. 10 for demos
DAILY_PRESS_CAP=50
PRESSES_PER_PLANT=10
LATCH_RELOCK_SECONDS=60         # servo locks the latch again after this time

# Sensor read intervals in seconds (one per sensor) — set after Sprint 1 tests
READ_INTERVAL_TEMP_HUMIDITY_SECONDS=
READ_INTERVAL_LIGHT_SECONDS=
READ_INTERVAL_UV_SECONDS=
READ_INTERVAL_PRESSURE_SECONDS=
READ_INTERVAL_SOIL_MOISTURE_SECONDS=
READ_INTERVAL_PIR_COUNT_SECONDS=

# API (FastAPI, also serves the web page)
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Web page login — one shared login for operators and partners
# Store only the password hash, never the plain password.
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=

# Database — InfluxDB 2 (Docker, deploy/compose.yaml)
DB_URL=http://localhost:8086
DB_ORG=
DB_BUCKET=pollinator
DB_TOKEN=

# MQTT broker — Mosquitto (Docker, bound to 127.0.0.1)
# Runs locally: the campus network blocks some outbound ports.
BROKER_HOST=localhost
BROKER_PORT=1883

# External data
EUSKALMET_API_KEY=

# Alerts — channel still open, see #42
ALERT_TOKEN=
ALERT_TARGET=
