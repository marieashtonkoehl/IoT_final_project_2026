# Copy to .env and fill in real values. Never commit .env.

# Station
STATION_ID=deusto-ria-01
PRESS_COOLDOWN_SECONDS=300      # 5 min in the real station; use e.g. 10 for demos
DAILY_PRESS_CAP=50
PRESSES_PER_PLANT=10

# API
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=pollinator
INFLUX_BUCKET=station

# MQTT (local broker — campus network blocks outbound MQTT)
MQTT_HOST=localhost
MQTT_PORT=1883

# External data
EUSKALMET_API_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
